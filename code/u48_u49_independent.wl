ClearAll[adaptiveHits];
adaptiveHits[support_List, total_Integer, draws_Integer] := Module[{available = Range[0, total - 1], state = 3, hits = 0, pos, x, bit}, Do[pos = 1 + Mod[7 state + 3 j, Length[available]]; x = available[[pos]]; available = Delete[available, pos]; bit = Boole[MemberQ[support, x]]; hits += bit; state = Mod[5 state + x + 11 bit + 3, 997], {j, 0, draws - 1}]; hits];
checks = Flatten[Table[Module[{supports = Subsets[Range[0, total - 1], {weight}], actual, expected}, actual = Table[Count[adaptiveHits[#, total, draws] & /@ supports, x], {x, 0, weight}]; expected = Table[Binomial[draws, x] Binomial[total - draws, weight - x], {x, 0, weight}]; actual === expected], {total, {4, 8}}, {weight, 0, total}, {draws, 0, total}], 2];
parameters = Table[Module[{n = pair[[1]], b = pair[[2]], s, low, h, ell, gap}, s = 2^b; low = Quotient[s, 10 n]; h = Quotient[low + 1, n] + 1; ell = IntegerLength[n + s + 1, 2]; gap = (n - b) s - ell - s (4 + 2 ell); {n, b, h, gap, 2^(10 b) s/2^n, 2^(10 b) s/(2^n h), 10 n^2 2^(10 b - n)}], {pair, {{128, 8}, {256, 16}, {512, 32}, {512, 48}, {1024, 96}, {2048, 192}}}];
majority = Table[Module[{len = If[OddQ[n + 1], n + 1, n + 2], error}, error = Sum[Binomial[len, j] (1/16)^j (15/16)^(len - j), {j, (len + 1)/2, len}]; error <= 2^(-len - 2) && 2^n error < 1 && len (8 + 32) <= 10 n 8], {n, 4, 128}];
<|"Version" -> $Version, "HypergeometricChecks" -> Length[checks], "HypergeometricPass" -> And @@ checks, "ParameterColumns" -> "n,b,h,countingGap,expectedHits,unconditionedMarkov,simplifiedMarkov", "Parameters" -> parameters, "MajorityChecks" -> Length[majority], "MajorityPass" -> And @@ majority, "RobustSelectionBound" -> ((129/127) (15/16) < 31/32)|>
